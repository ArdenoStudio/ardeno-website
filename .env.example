# Server-side secrets. Configure these in Vercel project environment variables.
GROQ_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Ardeno Studio <hello@ardenostudio.com>
ADMIN_EMAIL=hello@ardenostudio.com

# Comma-separated extra allowed origins for API requests, if needed.
ALLOWED_ORIGINS=https://ardenostudio.com,https://ardenostudio.com

# Optional abuse controls. The VITE Turnstile site key is public; the rest stay server-side.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
