# Server-side secrets. Configure these in the Cloudflare Pages dashboard:
# ardeno-studio > Settings > Environment variables (set for Production AND Preview).
# The functions/ API routes read them via context.env — nothing here is
# committed or bundled into the client.
GROQ_API_KEY=
RESEND_API_KEY=
RESEND_FROM=Ardeno Studio <hello@ardenostudio.com>
ADMIN_EMAIL=hello@ardenostudio.com

# Comma-separated extra allowed origins for API requests, if needed.
ALLOWED_ORIGINS=https://ardenostudio.com,https://www.ardenostudio.com

# Optional abuse controls. The VITE Turnstile site key is public (VITE_ prefix
# exposes it to the client build); the rest stay server-side.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local dev: `npx wrangler pages dev dist` reads these from .dev.vars
# (same format as this file, kept out of git).
